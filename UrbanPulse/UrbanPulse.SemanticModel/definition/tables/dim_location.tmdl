table dim_location
	lineageTag: f588f31d-ea4b-4134-a028-aaf17f028aaa

	column location_id
		dataType: string
		lineageTag: d655a656-9ffa-451d-aa08-2821a8eb6efa
		summarizeBy: none
		sourceColumn: location_id

		annotation SummarizationSetBy = Automatic

	column location_name
		dataType: string
		lineageTag: b036a330-a7bb-47f4-a0b7-55d534bf4cb9
		summarizeBy: none
		sourceColumn: location_name

		annotation SummarizationSetBy = Automatic

	column area
		dataType: string
		lineageTag: 52c8cc92-018e-40ec-ba2f-c6b42e02db7a
		summarizeBy: none
		sourceColumn: area

		annotation SummarizationSetBy = Automatic

	column latitude
		dataType: double
		lineageTag: 8c715622-151a-469c-904f-346c0b426742
		summarizeBy: none
		sourceColumn: latitude

		annotation SummarizationSetBy = Automatic

	column longitude
		dataType: double
		lineageTag: 39f29cf6-2638-44cc-930b-f916a1d16147
		summarizeBy: none
		sourceColumn: longitude

		annotation SummarizationSetBy = Automatic

	partition dim_location = m
		mode: import
		source =
				let
				    Source   = Csv.Document(File.Contents(DataFolder & "gold_dim_location.csv"),
				                            [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"location_id", "location_name", "area", "latitude", "longitude"}),
				    Typed    = Table.TransformColumnTypes(Selected,
				                   {{"location_id", type text}, {"location_name", type text}, {"area", type text},
				                    {"latitude", type number}, {"longitude", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
