table fact_weather_hourly
	lineageTag: e7b50ec8-60e7-4dea-99f3-8d04e8ce788b

	column hour_ts
		dataType: dateTime
		formatString: dd mmm yyyy HH:mm
		lineageTag: 07fd2597-8625-493a-ad45-43aad0254b9c
		summarizeBy: none
		sourceColumn: hour_ts

		annotation UnderlyingDateTimeDataType = DateTime

	column temperature
		dataType: double
		lineageTag: e148cd6f-d4b5-4c90-9c44-83c27663ce3e
		summarizeBy: none
		sourceColumn: temperature

