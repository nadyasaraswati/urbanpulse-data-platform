	column precip_max
		dataType: double
		lineageTag: 89392c2e-e8f3-469e-beee-ec4b091aff64
		summarizeBy: none
		sourceColumn: precip_max

		annotation SummarizationSetBy = Automatic

	column live_rows
		dataType: int64
		lineageTag: f183f449-ae5c-436f-89bf-c2fb90b244ac
		summarizeBy: none
		sourceColumn: live_rows

