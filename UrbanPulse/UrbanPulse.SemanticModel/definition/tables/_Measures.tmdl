table _Measures
	lineageTag: e4b13965-1167-47df-a6a4-c524ba7106ab

	measure 'Avg Congestion' = AVERAGE ( fact_traffic_hourly[avg_congestion_ratio] )
		formatString: 0.000
		lineageTag: 58466373-10e8-4c64-8387-8abb8dcb474c

	measure 'Max Congestion' = MAX ( fact_traffic_hourly[max_congestion_ratio] )
		formatString: 0.000
		lineageTag: a9dc25f5-7645-42b7-a9a7-6f13a11a3cfd

	measure 'Avg Speed' = AVERAGE ( fact_traffic_hourly[avg_speed] )
		formatString: 0.0
		lineageTag: 99b36bc5-644b-40af-99fe-a2e837db5016

	measure 'Road-Hours' = COUNTROWS ( fact_traffic_hourly )
		formatString: #,0
		lineageTag: 388714af-cefa-4bf2-b20c-876b17673997

	measure 'Observed Hours' = DISTINCTCOUNT ( fact_traffic_hourly[hour_ts] )
		formatString: #,0
		lineageTag: 964bc9ef-c3f6-422e-8a78-c030f09d6b62

	measure 'Congested Share' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_traffic_hourly ), fact_traffic_hourly[avg_congestion_ratio] > 0 ),
			    [Road-Hours]
			)
		formatString: 0.0%
		lineageTag: 9c2f138f-c440-4af6-b7fd-a6a39127cd96

	measure 'Zero Share' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_traffic_hourly ), fact_traffic_hourly[avg_congestion_ratio] = 0 ),
			    [Road-Hours]
			)
		formatString: 0.0%
		lineageTag: 22170535-01c7-4960-ac4d-62d6bb8f9529

	measure 'Congestion Std' = IF ( [Road-Hours] > 1, STDEV.S ( fact_traffic_hourly[avg_congestion_ratio] ) )
		formatString: 0.000
		lineageTag: 3e212279-2f32-44f3-a15e-2b763dd12e98

	measure 'Congestion Median' = MEDIAN ( fact_traffic_hourly[avg_congestion_ratio] )
		formatString: 0.000
		lineageTag: 62ee4f50-c694-49a3-9717-205b895a6d20

	measure 'Congestion P90' = PERCENTILE.INC ( fact_traffic_hourly[avg_congestion_ratio], 0.9 )
		formatString: 0.000
		lineageTag: 39790255-0d91-48e0-abf9-995f0ac2348e

	measure 'Speed Std' = IF ( [Road-Hours] > 1, STDEV.S ( fact_traffic_hourly[avg_speed] ) )
		formatString: 0.00
		lineageTag: 799c302c-2c0c-4411-a031-f63caa01e77f

	measure 'Speed CV' = DIVIDE ( [Speed Std], [Avg Speed] )
		formatString: 0.000
		lineageTag: 8e2a4e41-52b3-42db-8e2d-46beffc87866

	measure 'Rank Congestion' = RANKX ( ALLSELECTED ( dim_location[location_name] ), [Avg Congestion], , DESC, Dense )
		lineageTag: 28eb0384-2ce6-49ee-a563-f9579e8811b5

	measure 'Rank Stability' = RANKX ( ALLSELECTED ( dim_location[location_name] ), [Speed CV], , ASC, Dense )
		lineageTag: c91dbeef-b1c6-442c-95c7-6f897b8e4955

	measure 'Top Congested Road' =
			VAR T = TOPN ( 1, ALLSELECTED ( dim_location[location_name] ), [Avg Congestion], DESC )
			RETURN CONCATENATEX ( T, dim_location[location_name], ", " )
		lineageTag: 3b9d5914-43c3-4fc1-bf44-7f10f30d226e

	measure 'Most Stable Road' =
			VAR Valid = FILTER ( ALLSELECTED ( dim_location[location_name] ), NOT ISBLANK ( [Speed CV] ) )
			VAR T = TOPN ( 1, Valid, [Speed CV], ASC )
			RETURN CONCATENATEX ( T, dim_location[location_name], ", " )
		lineageTag: 403403e6-351d-4455-9a92-6aefa7875db0

	measure 'Peak Hour' =
			VAR H = ADDCOLUMNS ( VALUES ( fact_traffic_hourly[hour_of_day] ), "@Cong", [Avg Congestion] )
			VAR Top1 = TOPN ( 1, H, [@Cong], DESC )
			RETURN MINX ( Top1, fact_traffic_hourly[hour_of_day] )
		lineageTag: b1706920-5b38-4485-ae42-a2da34952255

	measure 'Peak Hour Label' = IF ( ISBLANK ( [Peak Hour] ), BLANK (), FORMAT ( [Peak Hour], "00" ) & ":00" )
		lineageTag: df276e8e-1927-4b89-8e12-0c983d22c882

	measure 'Slots' = COUNTROWS ( fact_traffic_30min )
		formatString: #,0
		lineageTag: 8a8f08ec-6e42-42c7-92be-de24acf3b3ad

	measure 'Avg Congestion 30m' = AVERAGE ( fact_traffic_30min[congestion_ratio] )
		formatString: 0.000
		lineageTag: e1d0ea64-2c6d-4a17-8fac-e64e25b6744d

	measure 'Avg Speed 30m' = AVERAGE ( fact_traffic_30min[current_speed] )
		formatString: 0.0
		lineageTag: 688c97fd-f020-44ec-a640-bfe01d25669a

	measure 'Congestion MA (±30 min)' =
			VAR Cur = MAX ( fact_traffic_30min[slot] )
			RETURN
			    CALCULATE (
			        [Avg Congestion 30m],
			        FILTER (
			            ALL ( fact_traffic_30min[slot] ),
			            fact_traffic_30min[slot] >= Cur - 1 / 48 && fact_traffic_30min[slot] <= Cur + 1 / 48
			        )
			    )
		formatString: 0.000
		lineageTag: 68099528-b5fe-4532-b658-28cd9026f377

	measure 'Speed MA (±30 min)' =
			VAR Cur = MAX ( fact_traffic_30min[slot] )
			RETURN
			    CALCULATE (
			        [Avg Speed 30m],
			        FILTER (
			            ALL ( fact_traffic_30min[slot] ),
			            fact_traffic_30min[slot] >= Cur - 1 / 48 && fact_traffic_30min[slot] <= Cur + 1 / 48
			        )
			    )
		formatString: 0.0
		lineageTag: 737cc8ea-58b5-4d5b-a963-6a49e34cf6e1

	measure 'Speed vs Travel Time (r)' =
			VAR N   = COUNTROWS ( fact_traffic_30min )
			VAR Sx  = SUMX ( fact_traffic_30min, fact_traffic_30min[current_speed] )
			VAR Sy  = SUMX ( fact_traffic_30min, fact_traffic_30min[current_travel_time] )
			VAR Sxy = SUMX ( fact_traffic_30min, fact_traffic_30min[current_speed] * fact_traffic_30min[current_travel_time] )
			VAR Sxx = SUMX ( fact_traffic_30min, fact_traffic_30min[current_speed] ^ 2 )
			VAR Syy = SUMX ( fact_traffic_30min, fact_traffic_30min[current_travel_time] ^ 2 )
			VAR Num = N * Sxy - Sx * Sy
			VAR Den = SQRT ( MAX ( 0, ( N * Sxx - Sx ^ 2 ) * ( N * Syy - Sy ^ 2 ) ) )
			RETURN IF ( N >= 3, DIVIDE ( Num, Den ) )
		formatString: 0.000
		lineageTag: 85246c5c-17dc-47f4-910f-ea8fa2e3f3f3

	measure 'Spikes' = SUM ( fact_traffic_30min[cong_spike] )
		formatString: #,0
		lineageTag: d5a1f685-7faa-4802-85b1-c1c2030abc0e

	measure 'Spike Share' = DIVIDE ( [Spikes], [Slots] )
		formatString: 0.0%
		lineageTag: f00742cc-3f9c-4046-b820-cbdad06f8bfc

	measure 'Z Anomalies' = SUM ( fact_traffic_30min[cong_anom_z] )
		lineageTag: dbb7a6fe-b6c9-40d9-9f17-37ba03b6b1c3

	measure 'IQR Anomalies' = SUM ( fact_traffic_30min[cong_anom_iqr] )
		lineageTag: a5add5b0-75aa-4678-ba13-dfac88583230

	measure 'Speed Anomalies' = SUM ( fact_traffic_30min[speed_anomaly] )
		formatString: #,0
		lineageTag: 1eda1f96-a65f-401c-9996-d5031a207db9

	measure 'Weather Hours' = COUNTROWS ( fact_weather_hourly )
		lineageTag: 3808b212-f202-4ecd-ae09-a3fb0cbc50fa

	measure 'Avg Temp' = AVERAGE ( fact_weather_hourly[temperature] )
		formatString: 0.0
		lineageTag: 273379b0-acbe-4df1-843b-7f12a6ad0408

	measure 'Max Rain' = MAX ( fact_weather_hourly[precip_max] )
		formatString: 0.0
		lineageTag: a4fa8482-80d7-4a26-9862-2082b7867100

	measure 'Rain Hours' = CALCULATE ( COUNTROWS ( fact_weather_hourly ), fact_weather_hourly[is_rain] = 1 )
		formatString: #,0
		lineageTag: e4720c8c-fc40-404b-abef-099b47f050d9

	measure 'Rain Days' = SUMX ( VALUES ( dim_hour[date] ), IF ( [Rain Hours] > 0, 1, 0 ) )
		lineageTag: a21c0f3d-5461-4c1f-9bfa-20a479dadebb

	measure 'Live Hours' = SUM ( fact_weather_hourly[is_live] )
		lineageTag: 17d3e8f4-8985-44b1-a07f-2de87eace201

	measure 'Rain Rows in Traffic Period' = CALCULATE ( COUNTROWS ( fact_traffic_hourly ), fact_traffic_hourly[precipitation] > 0 )
		lineageTag: 733a5944-f38a-4ce1-b9ce-2ec7c99723cb

	measure 'Traffic Period' =
			FORMAT ( MIN ( fact_traffic_30min[slot] ), "dd mmm yyyy HH:mm" ) & " – "
			    & FORMAT ( MAX ( fact_traffic_30min[slot] ), "dd mmm yyyy HH:mm" ) & " WIB"
		lineageTag: ff491f99-9145-4523-9f24-dabb0aabc65b

	measure 'Weekend Share' =
			DIVIDE (
			    COUNTROWS ( FILTER ( fact_traffic_hourly, WEEKDAY ( fact_traffic_hourly[obs_date], 2 ) > 5 ) ),
			    [Road-Hours]
			)
		formatString: 0%
		lineageTag: d7349706-7878-4c11-8c1c-a18379d4babf

	column Column1
		dataType: string
		isHidden
		lineageTag: 675c4108-0aa9-475b-8596-041d77b940a6
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Column1 = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
